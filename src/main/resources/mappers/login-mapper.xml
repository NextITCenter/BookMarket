<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="kr.or.nextit.bookmarket.login.LoginMapper">
	<select id="findByEmailAndPassword" parameterType="loginVO" resultType="memberVO">
		select
			id,
			email,
			password,
			name,
			register_date,
			modified_date
		from
			member
		where
			email = #{email}
			and password = #{password}
	</select>
</mapper>




